# Generated by `make ssh-config` from the Pulumi outputs. Used as: ssh -F ssh/config <host>
Host *
    User ubuntu
    StrictHostKeyChecking accept-new
    UserKnownHostsFile ssh/known_hosts
    ServerAliveInterval 15

Host nginx
    HostName NGINX_IP
    IdentityFile KEY_DIR/nginx.pem

Host master
    HostName MASTER_IP
    IdentityFile KEY_DIR/k3sCluster.pem

Host worker1
    HostName WORKER1_IP
    IdentityFile KEY_DIR/k3sCluster.pem

Host worker2
    HostName WORKER2_IP
    IdentityFile KEY_DIR/k3sCluster.pem
